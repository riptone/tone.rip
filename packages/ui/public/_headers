# Response headers for statically-served files.
#
# Middleware cannot do this: Workers Assets answers a request for a file in
# public/ before any Astro route or middleware runs, so a Cache-Control set
# there is never reached. This file is the only place these get set.
#
# Which is also why the security headers below are here and not only in
# @repo/hono-middleware. That middleware gives every HTML response ten of
# them - CSP, HSTS, nosniff, the rest - and gives the files in this directory
# none, because it never runs for them. Measured, not assumed: a request for
# /fonts/*.woff2 came back carrying Content-Type and Cache-Control and
# nothing else at all.

# The one that matters for every file: without it a browser may disregard the
# Content-Type above it and decide for itself what a file is, which is how a
# response meant to be read as data ends up executed as something else.
/*
  X-Content-Type-Options: nosniff

# Icons are content-stable and re-resolved on every navigation. Without a
# lifetime, each one is a revalidation round trip - a 304 per hop, and the
# previous icon showing while the next is fetched.
/favicon.ico
  Cache-Control: public, max-age=86400, s-maxage=604800

# SVG is the one asset here that is not an image the way the PNGs are: it is
# a document, and a document can carry <script>. Navigate straight to
# /favicon.svg and the browser renders it as a page in this origin, with this
# origin's cookies and storage. Ours is drawn by scripts/generate-brand.py
# from pure geometry and contains no script - but "the file happens to be
# safe" is not a control, and the control is one line.
#
# `style-src` is here because the mark does carry a <style> block, and a bare
# `default-src 'none'` would stop it rendering when opened directly.
/favicon.svg
  Cache-Control: public, max-age=86400, s-maxage=604800
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'

/icons/*
  Cache-Control: public, max-age=86400, s-maxage=604800

# Small static text, apps/web only - the rules simply never match on
# apps/dashboard, which is cheaper than un-sharing this file to say so.
#
# Without a rule Workers Assets answers these with `max-age=0,
# must-revalidate`, so every crawler and agent fetch is a round trip to
# revalidate a file that changes when the site is rebuilt and not between
# requests. An hour in the browser and a day at the edge; a sitemap that is a
# day stale still lists the same three routes.
/llms.txt
  Cache-Control: public, max-age=3600, s-maxage=86400

/ads.txt
  Cache-Control: public, max-age=3600, s-maxage=86400

/sitemap-*
  Cache-Control: public, max-age=3600, s-maxage=86400

# The webfont used to need a rule here, when it was a hand-named file in
# public/. It now lives in src/ and the bundler emits it under _astro/ with a
# content hash, where the adapter's own immutable rule already covers it - so
# the lifetime follows from the URL being unique rather than from this file
# and a naming convention agreeing with each other.
