---
// biome-ignore-all lint/correctness/noUnusedVariables: used in the template
// below the frontmatter fence, which Biome's Astro support doesn't analyze.
/**
 * The tone wordmark.
 *
 * Eight-bit pixels, not outlined type - see generate.py for the bitmaps and
 * why "t" is a cross and "n" isn't (inside the word; the standalone mark,
 * `markOnly`, is). Regenerate with packages/ui/src/brand/generate.py after a
 * bitmap change.
 *
 * The mark alone is what survives down to a 16px favicon, where the full
 * word would not.
 *
 * With `animate`, the letters snap in left to right like typed characters,
 * and the trailing cursor cell starts blinking once they have - the
 * wordmark arriving the way a terminal line does. Honoured only when the
 * visitor has not asked for reduced motion.
 */
interface Props {
  /** Play the type-in animation on mount. */
  animate?: boolean;
  /** Render only the mark (the headstone n). */
  markOnly?: boolean;
  class?: string;
  /** Accessible name. Set to "" when an adjacent label already names it. */
  label?: string;
}

const {
  animate = false,
  markOnly = false,
  class: className = "",
  label = "tone",
} = Astro.props as Props;

import markSvg from "./mark.svg?raw";
import wordmarkSvg from "./wordmark.svg?raw";

const source = markOnly ? markSvg : wordmarkSvg;
const classes = ["tw", animate && "tw--animate", className]
  .filter(Boolean)
  .join(" ");
const svg = source
  .replace("<svg", `<svg class="${classes}"`)
  .replace(
    'role="img"',
    label ? 'role="img"' : 'role="presentation" aria-hidden="true"',
  )
  .replace('aria-label="tone"', label ? `aria-label="${label}"` : "");
---

<Fragment set:html={svg} />
