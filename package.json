{
  "name": "tone.rip",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "biome check --write .",
    "format": "biome check --write --linter-enabled=false .",
    "lint": "biome check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "knip": "knip",
    "check-cycles": "madge --circular --extensions ts,tsx,astro apps packages",
    "check-bundle-size": "bun run scripts/check-bundle-size.ts",
    "outdated": "bun outdated",
    "ci": "bun run check && turbo run check-types test build //#lint //#knip //#check-cycles //#check-bundle-size e2e && git diff --exit-code -- apps/ssh-cv/internal/cv/cv.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "catalog:",
    "knip": "^6.43.0",
    "madge": "^8.0.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/config/*"
    ],
    "catalog": {
      "typescript": "5.9.2",
      "vitest": "4.1.11",
      "@vitest/coverage-v8": "4.1.11",
      "@vitest/coverage-istanbul": "4.1.11",
      "hono": "^4.13.14",
      "zod": "^4.5.2",
      "@hono/zod-validator": "^0.9.1",
      "astro": "^7.4.4",
      "@astrojs/cloudflare": "^14.4.3",
      "wrangler": "^4.155.0",
      "@playwright/test": "^1.64.1",
      "bun-types": "^1.4.4",
      "@astrojs/check": "^0.9.12",
      "jsdom": "^30.1.3",
      "@types/node": "^26.6.6"
    }
  }
}
