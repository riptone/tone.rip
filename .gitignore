# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
# Wrangler's local secrets file, which holds real credentials (GitHub token,
# Tailscale OAuth client secret). apps/api/.gitignore already covers its own
# copy; this is here so a second Worker added later is covered from the
# first commit rather than from the first time someone notices.
.dev.vars
.dev.vars.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage
test-results
playwright-report
blob-report

# The dotfiles repository, cloned here for convenience while apps/doti is
# built against it. It is a separate repo with its own history and its own
# remote, and it holds credential files - so committing it into this one
# would both duplicate a repo and copy secrets into a second history. It is
# also why `biome check` is not to descend into it: it carries a Biome 1.x
# config that this repo's Biome 2.x cannot deserialize.
dotfiles/

# Turbo
.turbo

# wrangler types output, one per Worker. Generated by turbo's `types` task
# (see turbo.json) rather than committed: they were 46,653 lines between them,
# they went stale silently, and they are not reproducible across machines
# because `wrangler types` reads the gitignored .dev.vars too.
worker-configuration.d.ts

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
