/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rittea-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  /**
   * Same reasoning as apps/api: bundled by wrangler from TypeScript and
   * deployed with --minify, so without a map every trace in the
   * observability panel is a column offset into one minified line.
   */
  "upload_source_maps": true,
  /**
   * No fetch handler is exported, so there is nothing to serve on a URL -
   * and no `routes`: Email Routing binds to this Worker by name, in the
   * dashboard (see README.md).
   */
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "RITTEA_URL": "https://rittea.tone.rip"
  },
  /**
   * Set with `wrangler secret put <NAME>`, never here.
   *
   * FORWARD_TO is not a credential, but it is a personal address and this
   * repository is public; as a secret it also survives `wrangler deploy`,
   * which would overwrite a var set in the dashboard. Listing both makes
   * `wrangler types` generate the same Env on every machine instead of
   * inferring it from a gitignored .dev.vars.
   */
  "secrets": {
    "required": ["EMAIL_ENTRADA_SEGREDO", "FORWARD_TO"]
  }
}
