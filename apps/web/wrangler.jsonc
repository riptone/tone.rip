{
  "name": "web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "routes": [
    { "pattern": "tone.rip", "custom_domain": true },
    { "pattern": "www.tone.rip", "custom_domain": true }
  ],
  "placement": { "mode": "smart" },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "SITE_ORIGIN": "https://tone.rip"
  },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "web-dev",
      "vars": {
        "SITE_ORIGIN": "https://dev.tone.rip"
      }
    }
  },
  "send_metrics": false
}
