{
  "name": "web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "routes": [
    { "pattern": "tone.rip", "custom_domain": true },
    { "pattern": "www.tone.rip", "custom_domain": true }
  ],
  "placement": { "mode": "smart" },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "SITE_ORIGIN": "https://tone.rip"
  },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "web-dev",
      "vars": {
        "SITE_ORIGIN": "https://dev.tone.rip"
      }
    }
  },
  "upload_source_maps": true,
  "send_metrics": false,
  // Astro's Cloudflare adapter session support (unused by this app today,
  // but the adapter provisions it regardless). Auto-created by `wrangler
  // deploy` on first deploy; pinned here so future deploys reuse it instead
  // of relying on re-provisioning.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "cace94dc952a471b84efdafd6e2cb024"
    }
  ]
}
