---
// biome-ignore-all lint/correctness/noUnusedImports: used in the template
// below the frontmatter fence, which Biome's Astro support doesn't analyze.
// biome-ignore-all lint/correctness/noUnusedVariables: ditto.

import { CONTACT } from "@repo/content";
import BaseHead from "@repo/ui/BaseHead.astro";
import Logo from "@repo/ui/brand/Logo.astro";
import ContextMenu, {
  type ContextMenuEntry,
} from "@repo/ui/site/ContextMenu.astro";
import Footer from "@repo/ui/site/Footer.astro";
import brandCss from "@repo/ui/styles/brand.css?inline";
import contextMenuCss from "@repo/ui/styles/context-menu.css?inline";
import gradientCss from "@repo/ui/styles/gradient.css?inline";
import resetCss from "@repo/ui/styles/reset.css?inline";
import shellCss from "@repo/ui/styles/shell.css?inline";
import siteFooterCss from "@repo/ui/styles/site-footer.css?inline";
import tokensCss from "@repo/ui/styles/tokens.css?inline";
import viewTransitionCss from "@repo/ui/styles/view-transition.css?inline";
import { SITE_NAME, SITE_URL } from "../consts";
import siteCss from "../styles/site.css?inline";

/**
 * The site shell.
 *
 * These are real pages with real URLs, not tabs - /work is a document a
 * crawler can index, a person can link to, and a browser can go back to. What
 * makes it *feel* like a section swap is a cross-document view transition:
 * the shell is identical either side of a navigation, the field is named so
 * the browser carries it across, and only the panel visibly changes.
 *
 * This used Astro's `<ClientRouter />` and no longer does. Two reasons, and
 * both were measured rather than argued:
 *
 * 1. CSP. ClientRouter navigates by fetching the next page and parsing it
 *    with DOMParser, and a parsed document inherits the *creating* page's
 *    policy - so the incoming <style> tags were checked against a nonce
 *    minted for a different response and refused, twice per navigation, in
 *    production only. See @repo/ui/styles/view-transition.css.
 *
 * 2. The 503s. ClientRouter prefetches on hover, and Cloudflare answers a
 *    speculative request to a Worker-backed route with
 *    `503` + `cf-speculation-refused: prefetch refused: disabled for worker
 *    requests`. Every hover over a nav link logged a failed request. Nothing
 *    in this repo can fix that from the inside; not asking is the fix.
 *
 * What was lost with it: the field's worker now restarts on each navigation
 * instead of being kept alive by `transition:persist`. It costs one
 * OffscreenCanvas handoff on a document that was already being parsed from
 * scratch, and the cross-fade between the two fields is the palette change
 * that used to be tweened in JavaScript - so the visible result is the same
 * one, done by the browser.
 */
interface Props {
  title: string;
  description: string;
  /** Which ramp this route paints the field with. */
  ramp?: string;
  /** Route id, for the nav's active state. */
  section: string;
  /**
   * This page's own stylesheet, appended after the shared one.
   *
   * The layout inlines its CSS into every response, and that response is
   * uncacheable - it carries a per-request CSP nonce - so a rule that only
   * one route uses is re-sent on every visit to every other route. Measured
   * before this existed: 16,279 B of CSS on `/`, 59% of it matching nothing
   * on the page, with the work filter and the CV list the bulk of it.
   *
   * Appended rather than prepended, which keeps the order these rules had
   * when they sat at the bottom of site.css.
   */
  pageCss?: string;
  /**
   * Extra JSON-LD for this page, merged after the site-wide `WebSite` node.
   *
   * Per page rather than site-wide because the useful nodes are page-shaped:
   * a `Person` belongs on the pages that describe one, and claiming it
   * everywhere would assert it on pages that show nothing to back it up.
   */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  ramp = "moss",
  section,
  schema,
  pageCss,
} = Astro.props as Props;

const cspNonce = Astro.locals.cspNonce as string | undefined;

const css = [
  tokensCss,
  resetCss,
  viewTransitionCss,
  shellCss,
  gradientCss,
  brandCss,
  siteFooterCss,
  contextMenuCss,
  siteCss,
  pageCss ?? "",
].join("\n");

/* Both languages per label, like every other string on the page - the nav
   was the one thing still rendering a bare string, so mountLang walked past
   it and the tabs stayed in English. */
const SECTIONS = [
  { id: "intro", en: "intro", pt: "início", href: "/" },
  { id: "work", en: "work", pt: "trabalho", href: "/work" },
  { id: "cv", en: "cv", pt: "cv", href: "/cv" },
];

const DASHBOARD = "https://dash.tone.rip";

/* The right-click menu. Everything here is either somewhere to go or
   something to put on the clipboard - see ContextMenu.astro for why that
   ceiling is deliberate.

   The link is the canonical URL rather than `location.href`, so sharing a
   page never passes along whatever tracking parameters brought someone to
   it. */
const MENU: ContextMenuEntry[] = [
  {
    label: "copy link",
    kind: "copy",
    value: new URL(Astro.url.pathname, SITE_URL).href,
  },
  { label: "copy email", kind: "copy", value: CONTACT.email, hint: "mail" },
  "separator",
  {
    label: "source",
    kind: "link",
    value: CONTACT.github,
    hint: "github",
    external: true,
  },
  "separator",
  {
    label: "log in",
    kind: "link",
    value: DASHBOARD,
    hint: "dashboard",
    external: true,
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      siteName={SITE_NAME}
      siteUrl={SITE_URL}
      title={title}
      description={description}
      css={css}
      schema={schema}
      theme="dark"
    />
    {/*
      Hold the first paint until the field has been parsed, which is the last
      element in <main> and therefore everything above it too.

      Without this a cross-document transition starts the moment the new
      document's <head> is ready, so the incoming snapshot is a half-built
      page - the shell with an empty panel - and it animates *that* in before
      the content lands. `rel="expect"` is the standards-track way to say
      "this is when the page is ready", and if the id never appears the
      browser releases the block when parsing ends rather than hanging.

      It looks like it should be expensive and it is not, which is worth
      writing down because Lighthouse's LCP breakdown puts the whole of this
      page's LCP under "element render delay" and this is the first thing
      anyone will suspect. Measured with `bun run perf`, three runs each:

        with     59 / 59 / 123 ms element render delay
        without  81 / 95 / 84 ms

      No difference beyond the noise, and LCP stays 0.3s and CLS stays 0
      either way. The delay is the document parsing and painting - there are
      no render-blocking resources at all - so holding the frame until the
      content exists is free.
    */}
    <link rel="expect" href="#field" blocking="render" />
  </head>
  <body data-ramp={ramp}>
    <main class="site shell">
      <div class="shell__reading">
        <a class="shell__brand" href="/" aria-label="tone, home">
          <Logo animate label="" />
        </a>

        <nav class="sitenav" aria-label="Sections">
          {
            SECTIONS.map((entry) => (
              <a
                class="sitenav__item"
                href={entry.href}
                data-section={entry.id}
                aria-current={entry.id === section ? "page" : undefined}
                data-en={entry.en}
                data-pt={entry.pt}
              >
                {entry.en}
              </a>
            ))
          }
        </nav>

        <div class="sitepanel">
          <slot />
        </div>

        <Footer
          github={CONTACT.github}
          handle={CONTACT.githubHandle}
          email={CONTACT.email}
          links={[
            {
              label: "cv",
              reveal: "ssh cv.tone.rip",
              describe: "Copy the command to read the CV over SSH",
            },
          ]}
          lang
        />
      </div>

      {/*
        The id is load-bearing twice over: it is what `rel="expect"` above
        waits for, and shell.css gives this element a `view-transition-name`
        so the browser carries the field across a navigation instead of
        replacing it with the rest of the page.
      */}
      <div class="shell__fieldwrap" id="field">
        <div class="shell__field" data-gradient-panel></div>
      </div>
    </main>

    <ContextMenu entries={MENU} />

    {/*
      Language before first paint. The document ships in English; the stored
      preference is in localStorage, so without this the page paints English
      then swaps to Portuguese — different string lengths, layout shift, 83%
      CLS on /. This runs as a blocking inline script at the end of body,
      after all [data-en] nodes are parsed but before the browser commits its
      first frame (and before rel=expect releases). The module script below
      stays for toggles and idempotency, but the first paint is already right.

      The loop runs for English too, where every write sets the string that is
      already there - T.astro renders `{en}` as both the text and the
      `data-en`. Skipping it for `l === "en"` was tried and measured, nine
      Lighthouse runs per variant, two replicates each:

        baseline   LCP 300ms, then 291ms
        skipped    LCP 291ms, then 308ms

      The identical build moved further between its own replicates than the
      change moved anything, and timing the loop directly in the page put it
      under 0.1ms across 200 iterations - nine nodes, not enough work to
      find. So it stays uniform: this applies the stored language whatever it
      is, and does not need the server to have rendered English to be correct.
    */}
    <script is:inline nonce={cspNonce}
      >try{var l=localStorage.getItem("lang");if(l!=="pt"&&l!=="en")l="en";document.documentElement.lang=l==="pt"?"pt-PT":"en";var ns=document.querySelectorAll("[data-en]");for(var i=0;i<ns.length;i++){var e=ns[i],v=e.dataset[l];if(v!==void 0)e.textContent=v}var bs=document.querySelectorAll("[data-lang-set]");for(var j=0;j<bs.length;j++)bs[j].setAttribute("aria-pressed",String(bs[j].dataset.langSet===l))}catch(e){}</script>

    <script>
      import {
        mountContact,
        mountContextMenu,
        mountFilter,
        mountLang,
        syncField,
      } from "@repo/ui/site";

      // Runs once per document, which since the move off ClientRouter is also
      // once per navigation - a real page load re-executes this module. There
      // used to be an `astro:page-load` listener here re-running everything
      // after each soft swap; with cross-document transitions the browser
      // gives us a new document and a new module instance, so the listener
      // would only ever have fired zero times.
      mountContact();
      mountContextMenu();
      // A no-op on pages with nothing to filter; /work is the only one so
      // far, and putting it here means a second such page needs no wiring.
      mountFilter();
      // The document renders in English, so this is what turns it into the
      // visitor's language. Before the field, because it is the control a
      // visitor might already be reaching for and the field is scenery.
      mountLang();

      /* `syncField` is a plain static import, and last, and that is the
         answer to a question worth not asking twice.

         The static import makes this module wait on the 4.2 KiB chunk
         holding the gradient - so Lighthouse draws a three-level request
         tree, and the obvious read is that the four mounts above are stuck
         behind scenery. Moving it to `import("@repo/ui/site/field")` was
         tried, and measured with `bun run perf`, three runs per variant on
         both presets:

           static   3 requests, 3 levels, chain 63/68/69ms desktop
           dynamic  4 requests, 3 levels, chain 66/67/78ms desktop

         Identical, because the two chunks arrive within ~10ms of each other
         and the page is server-rendered - FCP, LCP, TBT and CLS do not move
         either, on desktop or throttled mobile. What the dynamic version did
         buy was 0.41 KiB more entry chunk, a fourth request, and a rule that
         the site barrel may never re-export this. The depth never changed:
         the two chunks are siblings, and Lighthouse's indented list makes
         parallel requests read as a chain. */
      syncField();
    </script>
  </body>
</html>
