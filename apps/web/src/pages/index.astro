---
// biome-ignore-all lint/correctness/noUnusedImports: used in the template
// below the frontmatter fence, which Biome's Astro support doesn't analyze.
// biome-ignore-all lint/correctness/noUnusedVariables: ditto.
import { buildPersonSchema } from "@repo/content";
import T from "@repo/ui/site/T.astro";
import { SITE_NAME, SITE_URL } from "../consts";
import { INTRO } from "../copy/intro";
import SiteLayout from "../layouts/SiteLayout.astro";

/* Who this is, in a form a machine can read. The page says it in prose; this
   says the same thing in schema.org's vocabulary, built from the same CV the
   /cv page renders so the two cannot disagree. */
const person = buildPersonSchema({
  name: SITE_NAME,
  url: SITE_URL,
  sameAs: ["https://github.com/no-tone"],
});
---

<SiteLayout
  title="Software engineer · web applications end to end · tone"
  description="Software engineer building web applications end to end - the front-end, the API behind it, and the infrastructure both run on. Currently at a digital solutions studio, finishing an MSc in Software Engineering."
  section="intro"
  ramp="moss"
  schema={person}
>
  <h1 class="site__title">
    <T en="Hi, I'm tone." pt="Olá, sou o tone." />
  </h1>

  <div class="site__body">
    {INTRO.map((p) => <T as="p" en={p.en} pt={p.pt} />)}

    <!--
      Split rather than one <T>: the swap replaces textContent, so anything
      with markup inside it has to be assembled from separate pieces. The
      {" "} are load-bearing - JSX drops whitespace that spans a newline,
      and without them the words run together.
    -->
    <p>
      <T
        en="If you want to talk about any of that, the address is at the bottom of this page."
        pt="Se quiseres falar sobre alguma destas coisas, o endereço está no fim desta página."
      />
    </p>
  </div>
</SiteLayout>
