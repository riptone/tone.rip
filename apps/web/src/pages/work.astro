---
// biome-ignore-all lint/correctness/noUnusedImports: used in the template
// below the frontmatter fence, which Biome's Astro support doesn't analyze.
// biome-ignore-all lint/correctness/noUnusedVariables: ditto.

import { CONTACT } from "@repo/content";
import T from "@repo/ui/site/T.astro";
/* The filter's behavioural rules, and this page's own. Both used to be in
   the layout's shared sheet, which put them on the home page and the CV
   too - see SiteLayout's `pageCss` prop. This is the only route with
   anything to filter. */
import filterCss from "@repo/ui/styles/filter.css?inline";
import SiteLayout from "../layouts/SiteLayout.astro";
import { loadProjects } from "../services/projects";
import workCss from "../styles/work.css?inline";

const { repos, ok } = await loadProjects();

// Languages present in the list, for the tag picker. Derived rather than
// hardcoded so it can never offer a filter that matches nothing.
const languages = [...new Set(repos.map((r) => r.language))].sort();

// No Cache-Control is set here on purpose. There was a
// `public, max-age=300, s-maxage=900` on this page, reasoning that the list
// need not be fresher than the API's own 15-minute edge cache - but the
// security middleware overwrites Cache-Control on every HTML response with
// `private, max-age=0, must-revalidate`, and has to: the document carries a
// per-request CSP nonce, so a shared cache handing it to a second visitor
// would be handing them a nonce their response's policy never allowed.
// Verified against production, where /work answers with the private value.
//
// A line that looks like a caching decision and is discarded one layer up is
// worse than no line, so the reasoning is here instead of the header.
// Freshness is bounded by services/projects.ts's 15-minute memo, in the one
// place that can actually hold it.
---

<SiteLayout
  pageCss={[filterCss, workCss].join("\n")}
  title="Work · public repositories and projects · tone"
  description="Every public repository, newest first, straight from GitHub, filterable by language and topic. Forks and archived repositories are left out, so what is listed is work rather than history."
  section="work"
  ramp="tealBlush"
>
  <h1 class="site__title"><T en="Work" pt="Trabalho" /></h1>

  <div class="site__body">
    <p>
      <T
        en="Everything public, newest first, straight from GitHub. Forks and archived repositories are left out."
        pt="Tudo o que é público, do mais recente para o mais antigo, direto do GitHub. Forks e repositórios arquivados ficam de fora."
      />
    </p>
  </div>

  {
    repos.length === 0 && (
      <p class="work__note">
        {ok ? (
          <T
            en="Nothing public to show at the moment."
            pt="Nada público para mostrar de momento."
          />
        ) : (
          <T
            en="The project list is unavailable right now."
            pt="A lista de projetos está indisponível neste momento."
          />
        )}{" "}
        <a href={CONTACT.github} rel="noopener">
          {CONTACT.githubLabel}
        </a>
      </p>
    )
  }

  {
    repos.length > 0 && (
      <section class="workfilter" aria-label="Filter projects">
        <label class="workfilter__field" for="q">
          <span class="workfilter__label">
            <T en="search" pt="procurar" />
          </span>
          <input
            id="q"
            name="q"
            type="search"
            autocomplete="off"
            data-filter-search
          />
        </label>

        <label class="workfilter__field workfilter__field--tag" for="lang">
          <span class="workfilter__label">
            <T en="language" pt="linguagem" />
          </span>
          <select id="lang" name="lang" data-filter-tag>
            <option value="">
              <T en="all" pt="todas" />
            </option>
            {languages.map((language) => (
              <option value={language}>{language}</option>
            ))}
          </select>
        </label>

        <span class="workfilter__count" aria-live="polite" data-filter-count>{repos.length} / {repos.length}</span>
      </section>
    )
  }

  <p class="work__note" hidden data-filter-empty>
    <T en="Nothing matches that." pt="Nada corresponde a isso." />
  </p>

  <ul class="work">
    {
      repos.map((repo) => (
        <li
          class="work__item"
          data-filter-item
          data-name={repo.name}
          data-tags={[repo.language, ...repo.topics].join(",")}
        >
          <a class="work__name" href={repo.url} rel="noopener">
            {repo.name}
          </a>
          {repo.description && <p class="work__desc">{repo.description}</p>}
          <p class="work__meta">
            <span class="work__lang">{repo.language}</span>
            {repo.stars > 0 && <span class="work__stars">{repo.stars}★</span>}
            {/*
              The date the list is already sorted by, finally shown. It came
              down from the API with every repo and was rendered nowhere, so
              "newest first" in the note above was a claim the page gave the
              reader no way to check.

              ISO, sliced to the day, rather than a formatted or relative
              date: `<T>` would need a translation of every month name for a
              string that is the same fact in both languages, and "3 weeks
              ago" is a moving target rendered into a response that is cached
              for fifteen minutes. The `datetime` attribute carries the full
              timestamp for anything reading the page rather than looking at
              it.
            */}
            {repo.updatedAt && (
              <time class="work__updated" datetime={repo.updatedAt}>
                {repo.updatedAt.slice(0, 10)}
              </time>
            )}
            {repo.homepage && (
              <a class="work__live" href={repo.homepage} rel="noopener">
                <T en="live" pt="site" />
              </a>
            )}
          </p>
        </li>
      ))
    }
  </ul>
</SiteLayout>
