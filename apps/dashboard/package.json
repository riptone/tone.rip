{
  "name": "dashboard",
  "version": "0.0.0",
  "description": "A minimal launcher for self-hosted apps.",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check-types": "astro check",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "preview": "astro build && wrangler dev",
