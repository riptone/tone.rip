    "astro": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@playwright/test": "catalog:",
    "@repo/playwright-config": "*",
    "@repo/typescript-config": "*",
    "@repo/vitest-config": "*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
