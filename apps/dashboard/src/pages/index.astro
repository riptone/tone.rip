---
// biome-ignore-all lint/correctness/noUnusedVariables: these are used in the
// template below the frontmatter fence, which Biome's Astro support doesn't analyze.
// biome-ignore-all lint/correctness/noUnusedImports: same reason.
import { ALL_APP_TAGS, SELF_HOSTED_APPS } from "@repo/content";
import BaseHead from "@repo/ui/BaseHead.astro";
import Logo from "@repo/ui/brand/Logo.astro";
import ContextMenu, {
  type ContextMenuEntry,
} from "@repo/ui/site/ContextMenu.astro";
import Footer from "@repo/ui/site/Footer.astro";
import "@repo/ui/styles/tokens.css";
import "@repo/ui/styles/reset.css";
import "@repo/ui/styles/shell.css";
import "@repo/ui/styles/gradient.css";
import "@repo/ui/styles/brand.css";
// Before dashboard.css, which overrides a few of these for this page.
// Cascade order is the whole mechanism, so keep it.
import "@repo/ui/styles/site-footer.css";
import "@repo/ui/styles/context-menu.css";
import "@repo/ui/styles/filter.css";
import "../styles/dashboard.css";
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE, SITE_URL } from "../consts";

/* The launcher, rebuilt on the same frame as tone.rip.

   It used to be a "window" card with a titlebar, floating on a black page -
   a desktop metaphor inherited from the old site. The site has since dropped
   that metaphor, and a launcher is a list of links: it wants the same
   reading column, the same hairline rules and the same restraint about
   colour, so it now takes them from @repo/ui rather than reimplementing
   them. What is left in this app is what is genuinely its own: search,
   filtering, and live status.

   The gradient field comes along too. On a utility page it collapses to the
   narrow rail - enough to tie the two properties together, not enough to
   take space from the thing you came here to click. */

const EAGER_ICON_COUNT = 8;

const GITHUB = "https://github.com/no-tone";
const EMAIL = "m@tone.rip";

/* The counterpart to the site's "log in": this app is gated by Cloudflare
   Access, and /cdn-cgi/access/logout is the endpoint that actually drops the
   session - there is no app-level auth to sign out of. */
const MENU: ContextMenuEntry[] = [
  { label: "copy link", kind: "copy", value: SITE_URL },
  { label: "copy email", kind: "copy", value: EMAIL, hint: "mail" },
  "separator",
  {
    label: "tone.rip",
    kind: "link",
    value: "https://tone.rip",
    hint: "site",
    external: true,
  },
  {
    label: "source",
    kind: "link",
    value: GITHUB,
    hint: "github",
    external: true,
  },
  "separator",
  {
    label: "log out",
    kind: "link",
    value: "/cdn-cgi/access/logout",
    hint: "access",
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      siteName={SITE_NAME}
      siteUrl={SITE_URL}
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      theme="dark"
      robots="noindex, nofollow"
    />
  </head>
  <body data-ramp="quiet">
    <main class="dash shell">
      <div class="shell__reading">
        <a
          class="shell__brand"
          href="https://tone.rip"
          aria-label="tone, home"
        >
          <Logo label="" />
        </a>

        <header class="dash__head">
          <h1 class="dash__title">self-hosted</h1>
          <button
            class="dash__iconbtn dash__refresh"
            id="refresh"
            type="button"
            aria-label="Refresh statuses"
            title="Refresh statuses"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M17.65 6.35A7.95 7.95 0 0012 4a8 8 0 108 8h-2a6 6 0 11-6-6c1.66 0 3.14.69 4.22 1.78L14 10h6V4l-2.35 2.35z"
              ></path>
            </svg>
          </button>
        </header>

        <section class="dash__controls" aria-label="Search and filters">
          <label class="dash__field" for="q">
            <span class="dash__fieldlabel">search</span>
            <input
              id="q"
              name="q"
              type="search"
              placeholder="Type to filter, or press /"
              autocomplete="off"
              data-filter-search
            />
          </label>

          <label class="dash__field dash__field--tag" for="tag">
            <span class="dash__fieldlabel">tag</span>
            <select id="tag" name="tag" data-filter-tag>
              <option value="">all</option>
              {ALL_APP_TAGS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </label>

          <span class="dash__count" aria-live="polite" data-filter-count></span>
        </section>

        <ul class="dash__list" aria-label="Self-hosted applications">
          {
            SELF_HOSTED_APPS.map((app, i) => (
              <li>
                <a
                  class="tile"
                  href={app.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-filter-item
                  data-name={app.name.toLowerCase()}
                  data-href={app.href}
                  data-tags={app.tags.join(",")}
                >
                  {/*
                    A plain <img>, not astro:assets' <Image>.

                    These are remote .webp files on a CDN built for exactly
                    this. Astro cannot pre-optimise a remote image at build
                    time, so <Image> routed all nine through the runtime
                    /_image endpoint: nine Worker invocations per page load,
                    each fetching and re-encoding a file that was already the
                    right format at the right size. Letting the browser ask
                    jsDelivr directly removes the Worker from the path
                    entirely. img-src already allows https:.
                  */}
                  <span class="tile__icon" aria-hidden="true">
                    <img
                      src={app.iconUrl}
                      width="28"
                      height="28"
                      alt=""
                      loading={i < EAGER_ICON_COUNT ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={i < EAGER_ICON_COUNT ? "high" : "auto"}
                      referrerpolicy="no-referrer"
                    />
                  </span>
                  <span class="tile__name">{app.name}</span>
                  <span class="tile__tags">{app.tags.join(" · ")}</span>
                  <span
                    class="status"
                    data-status="unknown"
                    role="status"
                    aria-label="Status: unknown"
                  >
                    <span class="dot" aria-hidden="true" />
                    <span class="text">?</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="dash__empty" hidden data-filter-empty>No matches.</p>

        <Footer
          class="dashfoot"
          github="https://tone.rip"
          handle="tone.rip"
          email={EMAIL}
          links={[{ label: "status", href: "/api/status" }]}
        />
      </div>

      <div class="shell__fieldwrap">
        <div class="shell__field" data-gradient-panel></div>
      </div>
    </main>

    <ContextMenu entries={MENU} />

    <script>
      import { mountContact, mountContextMenu, syncField } from "@repo/ui/site";
      import { initDashboard } from "../scripts/dashboard";

      initDashboard();
      mountContact();
      mountContextMenu();
      // No options: the same field the site runs, differing only in the
      // palette, which comes from <body data-ramp>. A `feather` was tried
      // here and it only ate the panel's left edge - the field is a framed
      // rectangle, and fading one side of a frame reads as a rendering
      // fault rather than as light.
      syncField();
    </script>
  </body>
</html>
