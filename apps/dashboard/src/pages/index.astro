---
// biome-ignore-all lint/correctness/noUnusedVariables: these are used in the
// template below the frontmatter fence, which Biome's Astro support doesn't analyze.
// biome-ignore-all lint/correctness/noUnusedImports: same reason.

import BaseHead from "@repo/ui/BaseHead.astro";
import Logo from "@repo/ui/brand/Logo.astro";
import ContextMenu, {
  type ContextMenuEntry,
} from "@repo/ui/site/ContextMenu.astro";
import Footer from "@repo/ui/site/Footer.astro";
import "@repo/ui/styles/tokens.css";
import "@repo/ui/styles/reset.css";
import "@repo/ui/styles/shell.css";
import "@repo/ui/styles/gradient.css";
import "@repo/ui/styles/brand.css";
// Before dashboard.css, which overrides a few of these for this page.
// Cascade order is the whole mechanism, so keep it.
import "@repo/ui/styles/site-footer.css";
import "@repo/ui/styles/context-menu.css";
import "@repo/ui/styles/filter.css";
import "../styles/dashboard.css";
import { CONTACT } from "@repo/content";
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE, SITE_URL } from "../consts";
import { DEV_APPS } from "../dev-apps";
import { DEV_SECRETS } from "../dev-secrets";
import { ACCESS_JWT_HEADER, callApi } from "../lib/api";

/* The launcher, rebuilt on the same frame as tone.rip.

   It used to be a "window" card with a titlebar, floating on a black page -
   a desktop metaphor inherited from the old site. The site has since dropped
   that metaphor, and a launcher is a list of links: it wants the same
   reading column, the same hairline rules and the same restraint about
   colour, so it now takes them from @repo/ui rather than reimplementing
   them. What is left in this app is what is genuinely its own: the list,
   and the search and filter over it.

   There is no status column, and that is a decision rather than a gap. The
   board used to colour every row up/down/vpn from a mix of server probes,
   browser probes and a WebRTC guess at whether the visitor was on the
   tailnet. The services no longer sit behind Tailscale, and a launcher's job
   is to get you to the thing - which then tells you far more reliably than a
   dot whether it is up.

   The gradient field comes along too. On a utility page it collapses to the
   narrow rail - enough to tie the two properties together, not enough to
   take space from the thing you came here to click. */

const EAGER_ICON_COUNT = 8;

/* The same two names fetch.ts calls devHostnames, for the same reason:
   this is not production. */
const DEV_HOSTNAMES = new Set(["localhost", "127.0.0.1"]);

/* The tiles, from Cloudflare Access rather than from a list in this repo.
   Server-side, so the board arrives rendered rather than assembling itself
   after a round trip - and so the API token never leaves apps/api.

   Failure is degradation, not an error page: an empty list renders an empty
   board with the "No matches." line already in the markup, which is the
   honest thing for a launcher whose source is briefly unreachable. */
interface Tile {
  name: string;
  href: string;
  tags: string[];
  iconUrl: string | null;
}

/* On localhost the API is not called at all - the fixtures are used outright.
   A fallback that only fires when the call *fails* is not determinism: with a
   working network the real account answers, and the end-to-end tests go back
   to asserting on whatever it happens to contain. That is what made them pass
   here and fail in CI. Not making the request is the only version of this
   that cannot depend on production. */
/* What Bitwarden Secrets Manager holds, by name - apps/api's GET /secrets.
   Never values: the API does not read them, so this page cannot show them.
   It is here to answer "is that key backed up, and since when", which is
   the question a launcher for the services that use those keys gets asked. */
interface SecretRow {
  name: string;
  projects: string[];
  revisedAt: string;
}
type SecretsState = "ok" | "unconfigured" | "unavailable";

let apps: Tile[] = [];
let secrets: SecretRow[] = [];
let secretsState: SecretsState = "unavailable";

async function loadSecrets(): Promise<void> {
  try {
    const response = await callApi("/secrets", {
      jwt: Astro.request.headers.get(ACCESS_JWT_HEADER),
      timeoutMs: 4000,
    });
    if (!response.ok) return;
    const body = (await response.json()) as {
      secrets?: SecretRow[];
      state?: SecretsState;
    };
    secrets = body.secrets ?? [];
    secretsState = body.state ?? "unavailable";
  } catch {
    // Same rule as the tiles: a missing section, not an error page.
  }
}

if (DEV_HOSTNAMES.has(Astro.url.hostname)) {
  apps = DEV_APPS;
  secrets = DEV_SECRETS;
  secretsState = "ok";
} else {
  // In parallel with the tiles: the render waits for the slower of the two,
  // not for their sum.
  const secretsLoaded = loadSecrets();
  try {
    /* Through the `API` service binding rather than out to
       https://api.tone.rip and back - this render blocks on the answer, so
       the round trip was sitting in TTFB. See src/lib/api.ts.

       The deadline is this app's only one on this path, so it just has to be
       short enough that an unreachable API degrades to an empty board
       instead of hanging the page. */
    const response = await callApi("/apps", {
      jwt: Astro.request.headers.get(ACCESS_JWT_HEADER),
      timeoutMs: 4000,
    });
    if (response.ok) {
      apps = ((await response.json()) as { apps?: Tile[] }).apps ?? [];
    }
  } catch {
    // Left empty on purpose - an empty board is the honest answer when the
    // source of truth is unreachable. See the note above the interface.
  }
  await secretsLoaded;
}

/* The day only: when a key last changed is a question of days, and the
   time would invite reading it as when it was last *used*. */
const day = (iso: string) => iso.slice(0, 10);
const SECRETS_NOTE: Record<SecretsState, string | null> = {
  ok: null,
  unconfigured: "Not connected to Bitwarden.",
  unavailable: "Bitwarden did not answer.",
};

/* "Self-Hosted" is on every application by definition - it is the tag the API
   filters on - so as a *label* it distinguishes nothing and as a filter option
   it would select everything. It is hidden from both, and from `data-tags`
   too: that attribute exists only for the filter, and nothing in the browser
   needs to know why a tile is on the board.

   The API still returns it (see @repo/validation's toSelfHostedApps). Hiding a
   label is this page's concern, so it is done where the labels are drawn. */
const LAUNCHER_TAG = "self-hosted";
const visibleTags = (tags: string[]) =>
  tags.filter((tag) => tag.trim().toLowerCase() !== LAUNCHER_TAG);

const allTags = Array.from(
  new Set(apps.flatMap((app) => visibleTags(app.tags))),
).sort();

/* The counterpart to the site's "log in": this app is gated by Cloudflare
   Access, and /cdn-cgi/access/logout is the endpoint that actually drops the
   session - there is no app-level auth to sign out of. */
const MENU: ContextMenuEntry[] = [
  { label: "copy link", kind: "copy", value: SITE_URL },
  { label: "copy email", kind: "copy", value: CONTACT.email, hint: "mail" },
  "separator",
  {
    label: "tone.rip",
    kind: "link",
    value: "https://tone.rip",
    hint: "site",
    external: true,
  },
  {
    label: "source",
    kind: "link",
    value: CONTACT.github,
    hint: "github",
    external: true,
  },
  "separator",
  {
    label: "log out",
    kind: "link",
    value: "/cdn-cgi/access/logout",
    hint: "access",
  },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <BaseHead
      siteName={SITE_NAME}
      siteUrl={SITE_URL}
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      theme="dark"
      robots="noindex, nofollow"
    />
  </head>
  <body data-ramp="quiet">
    <main class="dash shell">
      <div class="shell__reading">
        <a
          class="shell__brand"
          href="https://tone.rip"
          aria-label="tone, home"
        >
          <Logo animate label="" />
        </a>

        <header class="dash__head">
          <h1 class="dash__title">self-hosted</h1>
        </header>

        <section class="dash__controls" aria-label="Search and filters">
          <label class="dash__field" for="q">
            <span class="dash__fieldlabel">search</span>
            <input
              id="q"
              name="q"
              type="search"
              placeholder="Type to filter, or press /"
              autocomplete="off"
              data-filter-search
            />
          </label>

          <label class="dash__field dash__field--tag" for="tag">
            <span class="dash__fieldlabel">tag</span>
            <select id="tag" name="tag" data-filter-tag>
              <option value="">all</option>
              {allTags.map((t) => <option value={t}>{t}</option>)}
            </select>
          </label>

          <span class="dash__count" aria-live="polite" data-filter-count>{apps.length} / {apps.length}</span>
        </section>

        <ul class="dash__list" aria-label="Self-hosted applications">
          {
            apps.map((app, i) => (
              <li>
                <a
                  class="tile"
                  href={app.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-filter-item
                  data-name={app.name.toLowerCase()}
                  data-tags={visibleTags(app.tags).join(",")}
                >
                  {/*
                    A plain <img>, not astro:assets' <Image>.

                    These are remote images on whatever host each Access
                    application names in its logo_url. Astro cannot
                    pre-optimise a remote image at build time, so <Image>
                    routed every one through the runtime /_image endpoint:
                    a Worker invocation per icon per page load, each fetching
                    and re-encoding a file that was already the right format
                    at the right size. Letting the browser fetch it directly
                    removes the Worker from the path entirely.

                    An application with no custom logo renders the first
                    letter of its name instead. A missing icon should leave a
                    tile that still reads, not a broken-image glyph.
                  */}
                  <span class="tile__icon" aria-hidden="true">
                    {app.iconUrl ? (
                      <img
                        src={app.iconUrl}
                        width="28"
                        height="28"
                        alt=""
                        loading={i < EAGER_ICON_COUNT ? "eager" : "lazy"}
                        decoding="async"
                        fetchpriority={i < EAGER_ICON_COUNT ? "high" : "auto"}
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <span class="tile__initial">{app.name.charAt(0)}</span>
                    )}
                  </span>
                  <span class="tile__name">{app.name}</span>
                  <span class="tile__tags">{visibleTags(app.tags).join(" · ")}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="dash__empty" hidden data-filter-empty>No matches.</p>

        {/*
          Collapsed by default: the launcher is what this page is for, and a
          list of credential names is something you open on purpose, not
          something that sits in view while you click through to an app.
        */}
        <details class="dash__secrets" data-secrets>
          <summary class="dash__secretshead">
            <span class="dash__fieldlabel">secrets</span>
            <span class="dash__count">{secrets.length}</span>
          </summary>
          {SECRETS_NOTE[secretsState] ? (
            <p class="dash__note">{SECRETS_NOTE[secretsState]}</p>
          ) : (
            <ul class="dash__secretlist" aria-label="Secrets in Bitwarden">
              {secrets.map((secret) => (
                <li class="secret">
                  <code class="secret__name">{secret.name}</code>
                  <span class="secret__projects">{secret.projects.join(" · ") || "no project"}</span>
                  <time class="secret__date" datetime={secret.revisedAt}>{day(secret.revisedAt)}</time>
                </li>
              ))}
            </ul>
          )}
        </details>

        <Footer
          class="dashfoot"
          github="https://tone.rip"
          handle="tone.rip"
          email={CONTACT.email}
        />
      </div>

      <div class="shell__fieldwrap">
        <div class="shell__field" data-gradient-panel></div>
      </div>
    </main>

    <ContextMenu entries={MENU} />

    <script>
      import {
        mountContact,
        mountContextMenu,
        mountFilter,
        syncField,
      } from "@repo/ui/site";

      // Search, tag and count are @repo/ui's - the same control the work list
      // uses. All this page supplies is the markup and its data attributes.
      // That was once wrapped in a scripts/dashboard.ts, alongside the status
      // checks; with those gone the wrapper would only be a second name for
      // this one call.
      mountFilter();
      mountContact();
      mountContextMenu();
      // No options: the same field the site runs, differing only in the
      // palette, which comes from <body data-ramp>. A `feather` was tried
      // here and it only ate the panel's left edge - the field is a framed
      // rectangle, and fading one side of a frame reads as a rendering
      // fault rather than as light.
      syncField();
    </script>
  </body>
</html>
