---
// biome-ignore-all lint/correctness/noUnusedImports: used in the template
// below the frontmatter fence, which Biome's Astro support doesn't analyze.

import NotFound from "@repo/ui/site/NotFound.astro";
import { SITE_NAME, SITE_URL } from "../consts";

/* It used to be a `<meta http-equiv="refresh">` bounce to `/`, which is not a
   404: it answered every mistyped URL with a redirect, so nothing ever said
   the page was missing. Behind Cloudflare Access that is actively confusing -
   a typo and an authorisation problem looked identical. */
---

<NotFound
  siteName={SITE_NAME}
  siteUrl={SITE_URL}
  title="404 · tone"
  description="This page doesn't exist."
  robots="noindex, nofollow"
  ramp="glacier"
/>
