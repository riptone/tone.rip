/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  /**
   * Uploaded to Cloudflare, never served to a browser: `assets.directory` is
   * ./public here and ../client on the Astro apps, and no .map is emitted into
   * either, so there is nothing at a public URL to find. They exist to
   * symbolicate stack traces in the observability panel above.
   *
   * Which is the whole reason this one is still true while apps/web's and
   * apps/dashboard's are gone. Those two hand wrangler an Astro build that
   * carries no maps, so the flag produced zero of them - a setting that reads
   * as a decision and does nothing. This Worker is bundled by wrangler from
   * TypeScript and deploys with --minify, so without a map every trace in the
   * log is a column offset into one minified line.
   *
   * It costs about 1.6MB per deploy, uploaded alongside the script and not
   * counted against its size limit.
   */
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.tone.rip", "custom_domain": true }]
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
